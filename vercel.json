{
  "regions": ["hnd1"],
  "builds": [
    { "src": "app.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "headers": { "cache-control": "public, max-age=86400" }, "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "app.py" }
  ]
}
